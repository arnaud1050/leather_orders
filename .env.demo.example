# Env file for the DEMO deployment only (docker-compose-demo.yml).
# Copy to .env.demo (already gitignored) and fill in real values there.
#
# Deliberately separate from the root .env that docker-compose.yml (prod)
# reads — see docs/deployment.md. Every variable below is optional; app.py
# falls back to the same insecure/placeholder default noted next to each if
# it's left unset, which is fine for a throwaway local test but not for
# anything reachable on the internet.

# Falls back to "dev-not-secure" if unset — set a real value before
# deploying anywhere reachable.
SECRET_KEY=

# The studio's own login, used only the first time this deployment's
# database is created. Falls back to admin@example.invalid / changeme.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The platform admin — belongs to no company, sees only /admin. Falls back
# to platform@example.invalid / changeme.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- Communications module (see communications/) --- all optional; unset,
# the app runs exactly as before and the integrations page explains what's
# missing.
COMMS_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be set on exactly ONE process — gunicorn runs 2 workers here, and two
# schedulers would sync every mailbox twice. Leave unset/0; "Sync now" on
# the integrations page still works either way.
RUN_SCHEDULER=0

# --- AI module (see ai/) --- encrypts the vendor API keys saved under
# Settings -> AI.
AI_ENCRYPTION_KEY=
