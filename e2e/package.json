{
  "name": "leather-orders-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the leather_orders app",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure open ./allure-results",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "allure": "^3.16.0",
    "allure-js-commons": "^3.0.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
