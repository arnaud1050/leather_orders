# Copy to `.env` in this folder to override any of these. Every one has a
# sensible default (see lib/env.ts) — this file only needs to exist for the
# defaults you actually want to change.

# --- Target ---------------------------------------------------------------
# Leave unset to have the suite auto-start Flask locally against a scratch
# database (recommended — see global-setup.ts). Set this to point at an
# already-running instance (Docker, staging) instead; doing so skips all
# local seeding and server management, so make sure that instance already
# has data your tests expect.
# E2E_BASE_URL=http://127.0.0.1:5013

# Port for the auto-started local Flask server (only used when E2E_BASE_URL
# is unset). The app's own `python app.py` hardcodes 5000; change this only
# if something else on your machine is already using it.
# E2E_PORT=5000

# --- Data -------------------------------------------------------------
# Where the scratch SQLite database lives. Deleted and recreated at the
# start of every run, and removed again at the end unless E2E_KEEP_DB=1.
# E2E_DB_PATH=./e2e/.tmp/e2e_test.db

# Point at a different fixture set (see seed/e2e-data.json for the shape)
# without touching any code.
# E2E_SEED_DATA_FILE=./e2e/seed/e2e-data.json

# Skip deleting the scratch DB after the run — handy when a test failed and
# you want to open the database (or sign in as the seeded admin) to see
# what state it was actually left in.
# E2E_KEEP_DB=1

# --- Environment ---------------------------------------------------------
# Defaults to .venv/Scripts/python.exe (Windows) or .venv/bin/python
# (everything else), resolved against the repo root. Override if your venv
# lives somewhere else.
# PYTHON_EXECUTABLE=C:/path/to/python.exe

# Flask SECRET_KEY for the auto-started server. Defaults to a fixed
# dev-only value (e2e-test-secret-key) — only set this if you need it to
# match something else.
# E2E_SECRET_KEY=some-fixed-value

# --- Browser behaviour -----------------------------------------------------
# "false" to watch tests run in a visible browser window.
# E2E_HEADLESS=false

# on | off | retain-on-failure
# E2E_VIDEO=retain-on-failure

# E2E_VIEWPORT_WIDTH=1280
# E2E_VIEWPORT_HEIGHT=800
